    private string password;
    private Perfil perfil;

    // Propriedades públicas
    public int Id { get; set; }
    public string Nome { get; set; }
    public string Email { get; set; }
    public string Password { get; set; }
    public Perfil Perfil { get; set; }

    // Métodos públicos
    public void Registar()
    {
        // Lógica para registrar o utilizador
        Console.WriteLine("Utilizador registado com sucesso!");
    }

    public bool Login(string email, string password)
    {
        // Lógica para verificar as credenciais de login
        return this.email == email && this.password == password;
    }

    public Transacao CriarTransacao(string descricao, decimal valor, Categoria categoria, TipoTransacao tipo)
    {
        // Cria e retorna uma nova transação
        Transacao novaTransacao = new Transacao
        {
            Descricao = descricao,
            Valor = valor,
            Categoria = categoria,
            Tipo = tipo,
            Data = DateTime.Now
        };
        return novaTransacao;
    }

    public Relatorio GerarRelatorio(DateTime inicio, DateTime fim)
    {
        // Cria e retorna um relatório
        return new Relatorio(inicio, fim);
    }
}

