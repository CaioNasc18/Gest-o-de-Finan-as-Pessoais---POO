@startuml
actor "Utilizador" as Uti
participant "Sistema" as Sis
participant "BaseDados" as BD

Uti -> Sis : Inserir email e password
Sis -> BD : Obter dados do utilizador
BD --> Sis : Retorna utilizador
Sis -> Sis : Validar credenciais
alt Credenciais corretas
    Sis --> Uti : Acesso autorizado
else Credenciais incorretas
    Sis --> Uti : Mostrar mensagem de erro //teste teste
end
@enduml
