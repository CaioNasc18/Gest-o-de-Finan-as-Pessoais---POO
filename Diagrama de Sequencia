@startuml

actor Utilizador as Uti
participant "Sistema" as Sis
participant "Transacao" as Tra
participant "Categoria" as Cat
participant "Relatorio" as Rel

Uti -> Sis : Login(email, password)
Sis --> Uti : Confirmação de login

Uti -> Sis : CriarTransacao(descricao, valor, categoria, tipo)
Sis -> Tra : ValidarValor()
Tra --> Sis : Valor válido
Sis -> Cat : AssociarCategoria()
Sis -> Tra : GuardarTransacao()
Sis --> Uti : Confirmação de registo

Uti -> Sis : GerarRelatorio(inicio, fim)
Sis -> Rel : CalcularTotalReceitas()
Sis -> Rel : CalcularTotalDespesas()
Sis -> Rel : GerarResumoPorCategoria()
Rel --> Sis : Relatório completo
Sis --> Uti : ExibirRelatório()

@enduml
